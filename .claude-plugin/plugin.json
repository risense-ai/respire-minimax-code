{
  "name": "respire-minimax-code",
  "version": "0.1.0",
  "description": "respire (rsrs) local-first encrypted memory for MiniMax Code: every-round title-tier recall, one-prefix store, Stop storage nudge, plus the full memory tool set over MCP. Register on rsrs.rs for sync; the sidecar model is an optional boost.",
  "author": {
    "name": "risense-ai",
    "url": "https://rsrs.rs"
  },
  "homepage": "https://rsrs.rs",
  "license": "MIT",
  "keywords": [
    "memory",
    "respire",
    "rsrs",
    "mcp",
    "agent-plugins",
    "local-first",
    "recall",
    "minimax-code",
    "mcode"
  ],
  "mcpServers": {
    "respire": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/respire-mcp.mjs"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/respire-hook.mjs",
              "SessionStart"
            ],
            "timeout": 10
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/respire-hook.mjs",
              "UserPromptSubmit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/io.minimax.mcode/hooks/scripts/respire-hook.mjs",
              "Stop"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
