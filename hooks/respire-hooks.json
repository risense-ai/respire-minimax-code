{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/respire-hook.mjs\" SessionStart",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\scripts\\respire-hook.mjs\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/respire-hook.mjs\" UserPromptSubmit",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\scripts\\respire-hook.mjs\" UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/scripts/respire-hook.mjs\" Stop",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\scripts\\respire-hook.mjs\" Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
